# Path to the Firebase service account JSON key file
# Download this from Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# Firebase project id (also inside the service account JSON, kept here for convenience)
FIREBASE_PROJECT_ID=hos-management-system

# Comma separated list of allowed CORS origins (your React dev server / production domain)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
